{
  "shortcuts": {
    "returnToMenu": {
      "key": "q"
    },
    "cancel": {
      "key": "escape"
    }
  },
  "statusHooks": {},
  "worktree": {
    "autoDirectory": true,
    "autoDirectoryPattern": "~/worktrees/{branch}",
    "copySessionData": true,
    "sortByLastSession": false
  },
  "worktreeHooks": {
    "post_creation": {
      "enabled": true,
      "command": "sh ~/.config/ccmanager/init_worktree.sh"
    }
  },
  "command": {
    "command": "claude",
    "args": [
      "--resume"
    ]
  },
  "commandPresets": {
    "presets": [
      {
        "id": "claude-yolo",
        "name": "Claude Code (YOLO new)",
        "command": "claude",
        "args": [
          "--dangerously-skip-permissions"
        ],
        "fallbackArgs": []
      },
      {
        "id": "claude-yolo-resume",
        "name": "Claude Code (YOLO Resume)",
        "command": "claude",
        "args": [
          "--resume",
          "--dangerously-skip-permissions"
        ],
        "fallbackArgs": []
      },
      {
        "id": "claude",
        "name": "Claude Code (new)",
        "command": "claude",
        "args": [],
        "fallbackArgs": []
      },
      {
        "id": "claude-resume",
        "name": "Claude Code (Resume)",
        "command": "claude",
        "args": [
          "--resume"
        ],
        "fallbackArgs": []
      },
      {
        "id": "codex",
        "name": "Codex (new)",
        "command": "codex",
        "detectionStrategy": "codex"
      },
      {
        "id": "gemini-yolo",
        "name": "Gemini (YOLO new)",
        "command": "gemini",
        "detectionStrategy": "gemini",
        "args": [
          "-y"
        ]
      }
    ],
    "defaultPresetId": "claude-yolo",
    "selectPresetOnStart": true
  },
  "autoApproval": {
    "enabled": true,
    "timeout": 30,
    "clearHistoryOnClear": false
  }
}
